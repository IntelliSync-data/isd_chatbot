<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        
        <!-- Chatbot Security Groups -->
        
        <!-- Chatbot Guest Group - Base level -->
        <record id="group_chatbot_guest" model="res.groups">
            <field name="name">Chatbot Guest</field>
            <field name="category_id" ref="base.module_category_services"/>
            <field name="comment">No access to chatbot features</field>
        </record>
        
        <!-- Chatbot User Group -->
        <record id="group_chatbot_user" model="res.groups">
            <field name="name">Chatbot User</field>
            <field name="category_id" ref="base.module_category_services"/>
            <field name="comment">Basic access to customer inquiries and conversations only</field>
            <field name="implied_ids" eval="[(4, ref('group_chatbot_guest'))]"/>
        </record>
        
        <!-- Chatbot Editor Group - separate branch from User: Q&A Configuration only -->
        <record id="group_chatbot_editor" model="res.groups">
            <field name="name">Chatbot Editor</field>
            <field name="category_id" ref="base.module_category_services"/>
            <field name="comment">Access to Q&amp;A Configuration only. Does not include customer inquiries or conversations.</field>
            <field name="implied_ids" eval="[(4, ref('group_chatbot_guest'))]"/>
        </record>

        <!-- Chatbot Manager Group - combines User (inquiries/conversations) and Editor (Q&A config) -->
        <record id="group_chatbot_manager" model="res.groups">
            <field name="name">Chatbot Manager</field>
            <field name="category_id" ref="base.module_category_services"/>
            <field name="comment">Sees all customer inquiries and conversations plus Q&amp;A Configuration. Not webhook logs/statistics or advanced configuration.</field>
            <field name="implied_ids" eval="[(4, ref('group_chatbot_user')), (4, ref('group_chatbot_editor'))]"/>
        </record>
        
        <!-- Chatbot Admin Group -->
        <record id="group_chatbot_admin" model="res.groups">
            <field name="name">Chatbot Admin</field>
            <field name="category_id" ref="base.module_category_services"/>
            <field name="comment">Full access including advanced configuration (Survey Mappings, Inquiry API, Inquiry Sources)</field>
            <field name="implied_ids" eval="[(4, ref('group_chatbot_manager'))]"/>
        </record>

        <!-- Assign Admin group to System Admin -->
        <record id="base.user_admin" model="res.users">
            <field name="groups_id" eval="[(4, ref('group_chatbot_admin'))]"/>
        </record>

        <!-- Record Rules: Inquiry visibility -->
        <record id="rule_inquiry_user" model="ir.rule">
            <field name="name">Inquiry: User sees assigned</field>
            <field name="model_id" ref="model_customer_inquiry"/>
            <field name="domain_force">[('assigned_user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_chatbot_user'))]"/>
        </record>

        <record id="rule_inquiry_manager" model="ir.rule">
            <field name="name">Inquiry: Manager sees all</field>
            <field name="model_id" ref="model_customer_inquiry"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_chatbot_manager'))]"/>
        </record>

        <!-- Record Rules: Conversation visibility (mirrors Inquiry visibility via customer_inquiry_id) -->
        <record id="rule_conversation_user" model="ir.rule">
            <field name="name">Conversation: User sees own assigned inquiry's conversations</field>
            <field name="model_id" ref="model_chatbot_conversation"/>
            <field name="domain_force">[('customer_inquiry_id.assigned_user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_chatbot_user'))]"/>
        </record>

        <record id="rule_conversation_manager" model="ir.rule">
            <field name="name">Conversation: Manager sees all</field>
            <field name="model_id" ref="model_chatbot_conversation"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_chatbot_manager'))]"/>
        </record>

    </data>
</odoo>