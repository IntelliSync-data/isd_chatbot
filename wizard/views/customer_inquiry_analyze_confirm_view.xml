<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_customer_inquiry_analyze_confirm_form" model="ir.ui.view">
        <field name="name">customer.inquiry.analyze.confirm.form</field>
        <field name="model">customer.inquiry.analyze.confirm</field>
        <field name="arch" type="xml">
            <form string="Confirm Re-analysis">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        This inquiry was previously analyzed on: <field name="analysis_date" readonly="1"/>
                        <br/>
                        Current information will be overwritten if new data is found in the message.
                    </div>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="email" readonly="1"/>
                        </group>
                        <group>
                            <field name="phone" readonly="1"/>
                            <field name="consultation_datetime" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="message" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Re-analyze" name="action_confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
