<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_inquiry_assign_wizard_form" model="ir.ui.view">
        <field name="name">inquiry.assign.wizard.form</field>
        <field name="model">inquiry.assign.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign User">
                <group>
                    <field name="inquiry_id" invisible="1"/>
                    <field name="next_action" invisible="1"/>
                    <field name="assigned_user_id" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button string="Confirm" type="object" name="action_confirm" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
